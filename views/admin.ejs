<div class="bg-white dark:bg-slate-900 p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 transition-colors mb-6">
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Panel de Administración</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Control de personal médico, roles institucionales y estadísticas.</p>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Registro y Gestión de usuarios (2 columnas) -->
        <div class="lg:col-span-2 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl bg-slate-50/50 dark:bg-slate-850">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-4 text-base flex items-center gap-2">
                <span>Registrar Nuevo Usuario</span>
            </h3>
            
            <form hx-post="/auth/register" hx-target="#register-msg" class="space-y-4">
