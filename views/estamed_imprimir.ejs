<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte Estadístico - <%= periodoNombre %> - Sistema Hospitalario</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body { background: #ffffff !important; }
            .no-print { display: none !important; }
            @page {
                size: A4 portrait;
                margin: 12mm 10mm 15mm 10mm;
            }
        }
        table {
            border-collapse: collapse;
            width: 100%;
            font-size: 11px;
        }
        th, td {
            border: 1px solid #000000;
            padding: 4px 6px;
        }
        th {
            background-color: #f1f5f9;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 10px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 font-sans p-4 sm:p-6 print:p-0">

    <!-- Barra Superior de Control (Oculta en Impresión) -->
    <div class="no-print max-w-5xl mx-auto mb-6 bg-slate-900 text-white p-4 rounded-xl shadow-md flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center gap-3">
            <span class="text-xs bg-blue-600 px-2.5 py-1 rounded font-mono font-bold uppercase">GESTIÓN CLÍNICA</span>
            <div>
                <h1 class="font-bold text-sm leading-tight">Planilla Oficial de Estadísticas Médicas y Epidemiología</h1>
                <p class="text-xs text-slate-300">Período: <span class="font-semibold text-white"><%= periodoNombre %></span> | Total: <span class="font-bold text-emerald-400"><%= filas.length %> registros</span></p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="<%= urlExcel %>" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                <span>Descargar Excel (.xlsx)</span>
            </a>
            <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                <span>Imprimir / PDF</span>
            </button>
            <button onclick="window.close()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition">
                Cerrar
            </button>
        </div>
    </div>

    <!-- DOCUMENTO OFICIAL HOSPITALARIO -->
    <div class="bg-white border border-gray-300 p-6 sm:p-8 rounded-sm shadow-sm print:border-0 print:p-0 print:shadow-none max-w-5xl mx-auto">
        
        <!-- Encabezado Superior -->
        <div class="flex justify-between items-start text-xs mb-2">
            <div>
                <p class="text-base font-bold tracking-wide text-blue-900">Sistema Hospitalario Central</p>
                <p class="text-xs text-gray-800"><%= autoridades.nombre_unidad %></p>
            </div>
            <div class="text-right italic text-xs text-gray-600">
                <p>“<%= autoridades.lema_anio %>”</p>
            </div>
        </div>

        <!-- Recuadro de Confidencialidad y Gobernanza de Datos -->
        <div class="border border-gray-400 my-3 p-2 max-w-2xl mx-auto text-center bg-gray-50">
            <p class="font-bold text-xs tracking-wider text-gray-900">CONFIDENCIALIDAD MÉDICA Y PROTECCIÓN DE DATOS</p>
            <p class="text-[10px] leading-tight text-gray-700 mt-0.5">
                Reporte de vigilancia epidemiológica y gestión de capacidad asistencial. Documento con datos despersonalizados y anonimizados con fines estadísticos y de control de calidad.
            </p>
        </div>

        <!-- Título Normativo -->
        <div class="text-center my-3">
            <h2 class="text-xs font-bold uppercase tracking-tight text-slate-900">
                INFORME CONSOLIDADO DE ATENCIONES MÉDICAS, DIAGNÓSTICOS Y DERIVACIONES
            </h2>
        </div>

        <!-- Datos Institucionales -->
        <div class="text-xs space-y-1 mb-4 pb-2 border-b border-gray-400">
            <div class="grid grid-cols-3 gap-2">
                <div><b>Código Hospitalario:</b> <%= autoridades.codigo_unidad %></div>
                <div class="text-center"><b>Período:</b> <%= periodoNombre %></div>
                <div class="text-right"><b>Fecha de Emisión:</b> <%= fechaEmision %></div>
            </div>
            <div><b>Director Médico General:</b> <%= autoridades.jefe_unidad_nombre %></div>
            <div><b>Jefe de Servicios Médicos:</b> <%= autoridades.jefe_sanidad_nombre %></div>
            <div><b>Coordinador de Estadísticas:</b> <%= autoridades.responsable_nombre %></div>
        </div>

        <!-- TABLA OFICIAL (10 COLUMNAS - SIN NOMBRES NI DNI) -->
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th style="width: 14%;">Servicio</th>
                        <th style="width: 11%;">Provincia</th>
                        <th style="width: 9%;">Ciudad</th>
                        <th style="width: 10%;">Fecha</th>
                        <th style="width: 6%;">Edad</th>
                        <th style="width: 8%;">Género</th>
                        <th style="width: 10%;">CIE-11</th>
                        <th style="width: 10%;">Cobertura</th>
                        <th style="width: 12%;">Área / Turno</th>
                        <th style="width: 10%;">Derivación</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!filas || filas.length === 0) { %>
                        <tr>
                            <td colspan="10" class="text-center py-8 text-gray-500 italic">
                                No se registraron atenciones médicas en el período seleccionado.
                            </td>
                        </tr>
                    <% } else { %>
                        <% filas.forEach(function(f) { %>
                            <tr>
                                <td class="text-center font-medium"><%= f.servicio %></td>
                                <td class="text-center"><%= f.provincia %></td>
                                <td class="text-center"><%= f.ciudad %></td>
                                <td class="text-center font-mono"><%= f.fecha %></td>
                                <td class="text-center font-mono"><%= f.edad !== null ? f.edad : '-' %></td>
                                <td class="text-center"><%= f.genero %></td>
                                <td class="text-center font-mono font-bold text-blue-700"><%= f.cie11 %></td>
                                <td class="text-center font-mono font-semibold">Cat <%= f.categoria %></td>
                                <td class="text-center font-mono"><%= f.circunstancia %></td>
                                <td class="text-center font-bold text-red-700"><%= f.derivacion || '-' %></td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pie Oficial de Firma -->
        <div class="mt-8 pt-2">
            <p class="text-xs text-right pr-2 mb-6">
                BUENOS AIRES,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= fechaPie %>
            </p>

            <div class="grid grid-cols-2 gap-8 items-start text-xs mt-6">
                <!-- Izquierda: Jefe de Servicios Médicos -->
                <div class="text-center px-4 pt-1 border-t border-gray-400">
                    <p class="font-bold tracking-wider text-[11px] mb-1">RESPONSABLE ASISTENCIAL</p>
                    <p class="text-xs text-black font-semibold uppercase"><%= autoridades.jefe_sanidad_nombre %></p>
                    <p class="text-[10px] text-gray-700"><%= autoridades.jefe_sanidad_cargo %></p>
                </div>

                <!-- Derecha: Director Médico General -->
                <div class="text-center px-4 pt-1 border-t border-gray-400">
                    <p class="font-bold tracking-wider text-[11px] mb-1">DIRECCIÓN MÉDICA GENERAL</p>
                    <p class="text-xs text-black font-semibold uppercase"><%= autoridades.jefe_unidad_nombre %></p>
                    <p class="text-[10px] text-gray-700"><%= autoridades.jefe_unidad_cargo %></p>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
