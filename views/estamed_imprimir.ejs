<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESTAMED - Anexo 1 - <%= periodoNombre %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @page {
            size: landscape;
            margin: 10mm 12mm;
        }
        body {
            font-family: 'Times New Roman', Times, serif;
            color: #000;
            background-color: #fff;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: transparent;
                padding: 0;
            }
            .page-break {
                page-break-after: always;
            }
        }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #777;
            padding: 3px 6px;
            font-size: 11px;
        }
        th {
            background-color: #f2f2f2 !important;
            font-weight: bold;
            text-align: center;
        }
    </style>
</head>
<body class="p-4 sm:p-8 max-w-7xl mx-auto">

    <!-- Barra de Herramientas Flotante (no se imprime) -->
    <div class="no-print bg-slate-900 text-white p-4 rounded-xl shadow-lg mb-6 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center gap-3">
            <span class="text-xs bg-blue-600 px-2.5 py-1 rounded font-mono font-bold uppercase">ESTAMED DGS 03/23</span>
            <div>
                <h1 class="font-bold text-sm leading-tight">Planilla Oficial de Estadísticas Médicas</h1>
                <p class="text-xs text-slate-300">Período: <span class="font-semibold text-white"><%= periodoNombre %></span> | Total: <span class="font-bold text-emerald-400"><%= filas.length %> registros</span></p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="<%= urlExcel %>" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                <span>Descargar Excel (.xlsx)</span>
            </a>
            <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                <span>Imprimir / PDF</span>
            </button>
            <button onclick="window.close()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition">
                Cerrar
            </button>
        </div>
    </div>

    <!-- DOCUMENTO OFICIAL ESTAMED -->
    <div class="bg-white border border-gray-300 p-6 sm:p-8 rounded-sm shadow-sm print:border-0 print:p-0 print:shadow-none">
        
        <!-- Encabezado Superior -->
        <div class="flex justify-between items-start text-xs mb-2">
            <div>
                <p class="text-base font-bold tracking-wide">Ejército Argentino</p>
                <p class="text-xs text-gray-800"><%= autoridades.nombre_unidad %></p>
            </div>
            <div class="text-right italic text-xs">
                <p>“<%= autoridades.lema_anio %>”</p>
            </div>
        </div>

        <!-- Recuadro Reglamentario de Seguridad Militar -->
        <div class="border border-black my-3 p-2 max-w-xl mx-auto text-center">
            <p class="font-bold text-xs tracking-wider">PUBLICO MILITAR</p>
            <p class="font-bold text-[11px] tracking-wider mt-0.5">ADVERTENCIA</p>
            <p class="text-[10px] leading-tight text-gray-800 mt-0.5">
                Este documento es de carácter <b>PUBLICO MILITAR</b> y el conocimiento de su contenido está limitado exclusivamente al personal de la Fuerza, siempre y cuando por orden de la autoridad superior no se dispusiere lo contrario (ROP-11-06 Art. 2.013 Inc e)
            </p>
        </div>

        <!-- Título Normativo -->
        <div class="text-center my-3">
            <h2 class="text-xs font-bold uppercase tracking-tight">
                ANEXO 1- (ESTAMED) A LA DIRECTIVA TECNICA DEL DIRECTOR GENERAL DE SALUD NRO 03/23 (Estadísticas Médicas)
            </h2>
        </div>

        <!-- Datos de la Unidad y Autoridades Responsables -->
        <div class="text-xs space-y-1 mb-4 pb-2 border-b border-gray-400">
            <div class="grid grid-cols-3 gap-2">
                <div><b>Código de Unidad:</b> <%= autoridades.codigo_unidad %></div>
                <div class="text-center"><b>Período:</b> <%= periodoNombre %></div>
                <div class="text-right"><b>Fecha de Emisión:</b> <%= fechaEmision %></div>
            </div>
            <div><b>Nombre del Jefe de Unidad:</b> <%= autoridades.jefe_unidad_nombre %></div>
            <div><b>Nombre del Jefe del Servicio de Sanidad:</b> <%= autoridades.jefe_sanidad_nombre %></div>
            <div><b>Nombre del Responsable Directo:</b> <%= autoridades.responsable_nombre %></div>
        </div>

        <!-- TABLA REGLAMENTARIA ESTAMED (10 COLUMNAS - SIN NOMBRES NI DNI) -->
        <div class="overflow-x-auto">
            <table>
                <thead>
                    <tr>
                        <th style="width: 12%;">UUMM</th>
                        <th style="width: 12%;">Provincia</th>
                        <th style="width: 8%;">Ciudad</th>
                        <th style="width: 10%;">Fecha</th>
                        <th style="width: 6%;">Edad</th>
                        <th style="width: 10%;">Genero</th>
                        <th style="width: 10%;">CIE-11</th>
                        <th style="width: 8%;">Categoria</th>
                        <th style="width: 10%;">Circunstancia</th>
                        <th style="width: 8%;">Derivacion</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!filas || filas.length === 0) { %>
                        <tr>
                            <td colspan="10" class="text-center py-8 text-gray-500 italic">
                                No se registraron atenciones médicas en el período seleccionado.
                            </td>
                        </tr>
                    <% } else { %>
                        <% filas.forEach(function(f) { %>
                            <tr>
                                <td class="text-center font-medium"><%= f.uumm %></td>
                                <td class="text-center"><%= f.provincia %></td>
                                <td class="text-center"><%= f.ciudad %></td>
                                <td class="text-center font-mono"><%= f.fecha %></td>
                                <td class="text-center font-mono"><%= f.edad !== null ? f.edad : '-' %></td>
                                <td class="text-center"><%= f.genero %></td>
                                <td class="text-center font-mono font-bold"><%= f.cie11 %></td>
                                <td class="text-center font-mono font-semibold"><%= f.categoria %></td>
                                <td class="text-center font-mono"><%= f.circunstancia %></td>
                                <td class="text-center font-bold text-red-700"><%= f.derivacion || '' %></td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pie Oficial con Lugar, Fecha y Bloques de Firma -->
        <div class="mt-6 pt-2">
            <p class="text-xs text-right pr-2 mb-6">
                CIUDAD AUTÓNOMA DE BUENOS AIRES,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= fechaPie %>
            </p>

            <div class="grid grid-cols-10 gap-2 items-start text-xs mt-6">
                <!-- Izquierda: Casillero de la Unidad (Columna A: Ca San / Cu Grl y 3 celdas vacías reglamentarias, total 4) -->
                <div class="col-span-2 text-center text-xs">
                    <div class="border border-black p-1 text-[11px] leading-tight font-normal">Ca San<br>Cu Grl</div>
                    <div class="border-x border-b border-black py-2.5">&nbsp;</div>
                    <div class="border-x border-b border-black py-2.5">&nbsp;</div>
                    <div class="border-x border-b border-black py-2.5">&nbsp;</div>
                </div>

                <!-- Centro: Jefe de Sanidad -->
                <div class="col-span-4 text-center px-4 pt-1">
                    <p class="font-bold tracking-wider text-[11px] mb-1">FIRMADO</p>
                    <p class="text-xs text-black font-normal uppercase"><%= autoridades.jefe_sanidad_nombre %></p>
                    <p class="text-[10px] text-gray-800"><%= autoridades.jefe_sanidad_cargo %></p>
                </div>

                <!-- Derecha: Jefe de Unidad -->
                <div class="col-span-4 text-center px-4 pt-1">
                    <p class="font-bold tracking-wider text-[11px] mb-1">FIRMADO</p>
                    <p class="text-xs text-black font-normal uppercase"><%= autoridades.jefe_unidad_nombre %></p>
                    <p class="text-[10px] text-gray-800"><%= autoridades.jefe_unidad_cargo %></p>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
